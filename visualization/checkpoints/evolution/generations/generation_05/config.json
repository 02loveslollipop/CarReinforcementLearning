{
  "environment": {
    "random_start": true,
    "observe_dynamics": true,
    "track": [
      "circuit",
      "oval",
      "clover"
    ]
  },
  "training": {
    "seed": 6,
    "hidden_sizes": [
      128,
      128
    ],
