    "epsilon_start": 0.1,
    "epsilon_end": 0.025,
    "epsilon_decay_steps": 60000,
    "epsilon_local_fraction": 0.75,
    "target_update_tau": 0.005,
    "gradient_clip": 5.0,
    "checkpoint_every": 10000
