{
  "environment": {
    "random_start": true,
    "observe_dynamics": true,
    "track": [
      "circuit",
      "oval",
      "clover"
    ]
  },
  "training": {
    "seed": 6,
    "hidden_sizes": [128, 128],
    "force_bins": 5,
    "steering_bins": 7,
    "learning_rate": 0.0003,
    "gamma": 0.995,
    "batch_size": 128,
    "replay_capacity": 120000,
    "learning_starts": 2000,
    "train_frequency": 2,
    "target_update_frequency": 1000,
    "target_update_tau": 0.01,
    "epsilon_start": 1.0,
    "epsilon_end": 0.05,
    "epsilon_decay_steps": 60000,
    "gradient_clip": 5.0,
    "checkpoint_every": 10000
  },
  "reward": {
    "forward_progress_weight": 1.0,
    "collision_penalty": 50.0,
    "inactivity_penalty": 0.005,
    "inactivity_threshold": 0.0001
  }
}
